---
# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
properties:
  configurationVersion: 0.2.0
  assertions:
    - resource: Microsoft.Windows.Developer/OsVersion
      directives:
        description: Verify min OS version requirement
        allowPrerelease: true
      settings:
        MinVersion: "10.0.19041"
  resources:
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: uninstallWitsy
      directives:
        description: Uninstall Witsy
        allowPrerelease: true
      settings:
        Id: KochavaStudios.Witsy
        Source: winget
        Ensure: Absent
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: installAntigravityCLI
      directives:
        description: Install Antigravity CLI
        allowPrerelease: true
      settings:
        Id: Google.AntigravityCLI
        Source: winget
        Ensure: Present
        Version: "1.1.28"
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: installCherryStudio
      directives:
        description: Install Cherry Studio
        allowPrerelease: true
      settings:
        Id: kangfenmao.CherryStudio
        Source: winget
        Ensure: Present
        Version: "2.0.13"
